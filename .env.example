# --- Database (Neon via Vercel Marketplace) ---
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# --- Redis (Upstash via Vercel Marketplace) ---
REDIS_URL="rediss://default:pass@host:6379"

# --- Auth (Better-Auth) ---
BETTER_AUTH_SECRET="generate with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# --- AI Gateway (Vercel) ---
AI_GATEWAY_API_KEY="vg-xxx..."
AI_GATEWAY_DEFAULT_MODEL="meta-llama/llama-3.3-70b-instruct"
AI_GATEWAY_FALLBACK_MODEL="mistralai/mistral-large-latest"
MAYA_DAILY_TOKEN_CAP_PER_USER="25000"

# --- Colyseus realtime server ---
COLYSEUS_URL="ws://localhost:2567"
COLYSEUS_AUTH_SECRET="generate with: openssl rand -base64 32"

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# --- Observability ---
SENTRY_DSN=""
POSTHOG_KEY=""
POSTHOG_HOST="https://eu.posthog.com"

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_MULTIPLAYER="true"
NEXT_PUBLIC_ENABLE_MAYA_AI="true"
NEXT_PUBLIC_ENABLE_VOICE="false"
