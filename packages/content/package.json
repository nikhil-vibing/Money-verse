{
  "name": "@money-verse/content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./quests/*": "./quests/*",
    "./i18n/*": "./i18n/*"
  },
  "scripts": {
    "build": "tsc && pnpm content:compile",
    "test": "vitest run",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "content:compile": "node scripts/compile.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@money-verse/shared": "workspace:*",
    "zod": "^3.23.0"
  },
  "files": [
    "src",
    "i18n",
    "scripts"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
