{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "TodoWrite",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "Bash(pnpm install*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm db:*)",
      "Bash(pnpm content:*)",
      "Bash(pnpm assets:*)",
      "Bash(pnpm i18n:*)",
      "Bash(pnpm run*)",
      "Bash(pnpx *)",
      "Bash(pnpm dlx *)",
      "Bash(turbo *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git stash list)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git restore*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh api repos/*)",
      "Bash(ls *)",
      "Bash(find . *)",
      "Bash(rg *)",
      "Bash(grep *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(jq *)",
      "Bash(node --version)",
      "Bash(pnpm --version)",
      "Bash(tsc --noEmit*)",
      "Bash(biome *)",
      "Bash(eslint *)",
      "Bash(vitest *)",
      "Bash(playwright *)",
      "Bash(drizzle-kit *)",
      "Bash(vercel *)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /Users*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(yarn install*)",
      "Bash(yarn add *)",
      "Bash(bun install*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(wget * | sh*)",
      "Bash(:(){ :|:& };:)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=\"$CLAUDE_TOOL_FILE_PATH\"; if [ -n \"$FILE\" ] && echo \"$FILE\" | grep -qE '\\.(ts|tsx|js|jsx|json|css)$'; then pnpm exec biome format --write \"$FILE\" 2>/dev/null || true; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "CMD=\"$CLAUDE_TOOL_COMMAND\"; if echo \"$CMD\" | grep -qE '(^|[^a-z])npm (install|i |add)'; then echo 'BLOCKED: use pnpm, not npm' >&2; exit 2; fi"
          }
        ]
      }
    ]
  },
  "env": {
    "FORCE_COLOR": "1"
  },
  "model": "claude-opus-4-7",
  "outputStyle": "default",
  "statusLine": {
    "type": "text",
    "format": "🪙 Dhaniverse 2.0 · ${branch} · ${model}"
  }
}
