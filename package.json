{
  "name": "money-verse",
  "version": "0.1.0",
  "private": true,
  "description": "Money-verse — 2D HD-pixel RPG that teaches Indians to manage money.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@money-verse/web",
    "dev:game": "turbo run dev --filter=@money-verse/game",
    "dev:server": "turbo run dev --filter=@money-verse/server",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "lint": "biome check . && turbo run lint",
    "lint:fix": "biome check --write . && turbo run lint:fix",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "db:push": "turbo run db:push --filter=@money-verse/shared",
    "db:studio": "turbo run db:studio --filter=@money-verse/shared",
    "db:migrate": "turbo run db:migrate --filter=@money-verse/shared",
    "content:compile": "turbo run content:compile --filter=@money-verse/content",
    "assets:atlas": "turbo run assets:atlas --filter=@money-verse/game",
    "i18n:check": "turbo run i18n:check --filter=@money-verse/content",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.5.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
