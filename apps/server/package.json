{
  "name": "@dhaniverse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:tick-size": "vitest run tests/tick-size",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.43",
    "@colyseus/monitor": "^0.17.8",
    "@colyseus/schema": "^5.0.3",
    "@colyseus/ws-transport": "^0.17.13",
    "@dhaniverse/finance-sim": "workspace:*",
    "@dhaniverse/game-protocol": "workspace:*",
    "@dhaniverse/shared": "workspace:*",
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.12.18",
    "ioredis": "^5.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
